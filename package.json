{
  "name": "aira",
  "version": "1.0.0",
  "description": "A WhatsApp chatbot agent that plays a configured character in each chat",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:restart": "vitest run tests/restart",
    "test:migration": "vitest run tests/migration",
    "test:simulator": "vitest run tests/simulator",
    "test:gates": "vitest run tests/gates tests/contract/prompt-gates.test.ts tests/unit/format-corpus.test.ts",
    "prepare": "husky",
    "diagrams": "node scripts/export-diagrams.mjs",
    "turn": "tsx scripts/turn.ts",
    "report": "tsx scripts/report.ts",
    "bench": "tsx scripts/bench.ts",
    "chat": "tsx scripts/chat.ts",
    "sim": "tsx scripts/sim.ts",
    "pack:check": "tsx scripts/pack-check.ts",
    "export:memory": "tsx scripts/export-memory.ts",
    "migrate:memory": "tsx scripts/migrate-memory.ts",
    "migrate:settings": "tsx scripts/migrate-settings.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write --no-errors-on-unmatched",
    "*.{md,json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@google/adk": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
